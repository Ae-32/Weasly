rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function checking if a request comes from an authenticated user accessing their own ID
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Match all user profile documents and subcollections under /users/{userId}
    match /users/{userId} {
      // Allows user to read and write their own profile document (/users/{userId})
      allow read, write: if isOwner(userId);

      // Allows user to read and write all subcollections (/accounts, /transactions, /categories, /budgets, /recurringBills)
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Explicitly deny access to any other collections or root paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
